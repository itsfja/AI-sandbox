#!/usr/bin/env bash
# Mock lxc-info: only `lxc-info -n <id> -sH`. RUNNING while $MOCK_T/run/<id>
# (or mid-Stop, $MOCK_T/stopping/<id>) exists, STOPPED when configured,
# else "doesn't exist" like a CT lxc has never started.
T="${MOCK_T:?}"
echo "lxc-info $*" >> "$T/calls.log"
id=""
while [ $# -gt 0 ]; do case "$1" in -n) id="$2"; shift 2 ;; *) shift ;; esac; done
if [ -e "$T/run/$id" ] || [ -e "$T/stopping/$id" ]; then echo RUNNING
elif [ -e "$T/conf/$id.conf" ]; then echo STOPPED
else echo "$id doesn't exist" >&2; exit 1
fi
