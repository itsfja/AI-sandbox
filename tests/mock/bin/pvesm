#!/usr/bin/env bash
# Mock pvesm: `path <storage>:<volume>` -> /dev/pve/<volume> (lvm-style).
echo "pvesm $*" >> "$MOCK_T/calls.log"
if [ "$1" = path ]; then
  case "$2" in
    *:*/*) echo "/dev/zvol/mock/${2##*/}" ;;
    *:*)   echo "/dev/pve/${2#*:}" ;;
    *)     echo "/dev/mock-thin-$RANDOM" ;;
  esac
fi
exit 0
